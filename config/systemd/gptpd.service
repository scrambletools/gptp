[Unit]
Description=AVB bridge: gPTP (802.1AS) time-aware relay on the switch ports
# Started as br0 appears, not once it has an address: an end station that
# gets no Pdelay answer for about 9 s after its link comes up may fall back
# to AVB Lite until its next link-up, and a DHCP lease can take longer.
# br0 must have its own MAC as it appears, which names the relay.
After=sys-subsystem-net-devices-br0.device
Wants=sys-subsystem-net-devices-br0.device
# One gPTP daemon at a time: starting this one stops linuxptp's, and
# starting gptp-bridge stops this one. Ordered too, so the stop is done
# before the start either way: two responders to one Pdelay_Req, even
# once, make a strict neighbor fall back to plain PTP.
Conflicts=gptp-bridge.service gptp-phc2sys.service
After=gptp-bridge.service gptp-phc2sys.service
# However often it fails, start it again: an unattended bridge without
# gPTP stops every stream through it.
StartLimitIntervalSec=0

[Service]
# enp1s0 is the uplink to a LAN without AVB: no gPTP there, but its clock
# is the LocalClock, as no loop test resets that card. A port runs only
# while it is in br0, so one taken out for a loop test is left be.
ExecStart=/usr/local/sbin/gptpd --bridge br0 --clock enp1s0 enp2s0 enp3s0 enp4s0 enp5s0 enp6s0
RuntimeDirectory=gptpd
Restart=on-failure
# Back before neighbors give up on it: after 3 unanswered Pdelay requests,
# 3 s, a neighbor counts the link not asCapable and fails every stream
# crossing it.
RestartSec=1
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
# Above every other program but below the streams (round robin 15), and
# kept in RAM (it locks itself), so neither builds nor swapping delay a
# frame long enough to read as a Sync or a Pdelay response lost.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
LimitMEMLOCK=infinity
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
